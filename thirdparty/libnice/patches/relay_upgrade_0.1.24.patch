+
+/* Background checks share the existing sockets, credentials and Ta pacing.
+ * They never clear the selected relay or restart ICE/DTLS. The extension is
+ * opt-in because RFC 8445 regular nomination normally stops after selection. */
+static gboolean
+priv_selected_pair_is_relay (NiceComponent *component)
+{
+  CandidatePair *pair = &component->selected_pair;
+  return pair->local && pair->remote &&
+      (pair->local->c.type == NICE_CANDIDATE_TYPE_RELAYED ||
+       pair->remote->c.type == NICE_CANDIDATE_TYPE_RELAYED);
+}
+
+static gboolean
+priv_relay_upgrade_active (NiceAgent *agent, NiceComponent *component)
+{
+  return agent->relay_upgrade_timeout > 0 && !agent->force_relay &&
+      agent->nomination_mode == NICE_NOMINATION_MODE_REGULAR &&
+      priv_selected_pair_is_relay (component) &&
+      component->relay_upgrade_deadline > g_get_monotonic_time ();
+}
+
+static gboolean
+priv_is_direct_upgrade (NiceComponent *component, CandidateCheckPair *pair)
+{
+  return pair->component_id == component->id &&
+      pair->priority > component->selected_pair.priority &&
+      pair->local->type != NICE_CANDIDATE_TYPE_RELAYED &&
+      pair->remote->type != NICE_CANDIDATE_TYPE_RELAYED;
+}
+
+static gboolean
+priv_conn_check_tick_relay_upgrade (NiceAgent *agent, NiceStream *stream)
+{
+  GSList *i, *j;
+  gboolean keep_timer_going = FALSE;
+  gint64 now = g_get_monotonic_time ();
+
+  for (i = stream->components; i; i = i->next) {
+    NiceComponent *component = i->data;
+    gboolean nominate_pending = FALSE;
+    gboolean retry;
+    if (!priv_relay_upgrade_active (agent, component))
+      continue;
+    keep_timer_going = TRUE;
+    retry = now >= component->relay_upgrade_next_retry;
+    if (retry)
+      component->relay_upgrade_next_retry = now + 3 * G_USEC_PER_SEC;
+
+    /* Do not nominate a second pair while another nomination is in flight. */
+    for (j = stream->conncheck_list; j; j = j->next) {
+      CandidateCheckPair *p = j->data;
+      if (priv_is_direct_upgrade (component, p) &&
+          p->use_candidate_on_next_check && !p->nominated &&
+          p->state != NICE_CHECK_FAILED)
+        nominate_pending = TRUE;
+    }
+    for (j = stream->conncheck_list; j; j = j->next) {
+      CandidateCheckPair *p = j->data;
+      CandidateCheckPair *check;
+      if (!priv_is_direct_upgrade (component, p))
+        continue;
+      if (agent->controlling_mode && !nominate_pending && p->valid &&
+          !p->nominated && (p->state == NICE_CHECK_SUCCEEDED ||
+                           p->state == NICE_CHECK_DISCOVERED)) {
+        check = p->succeeded_pair ? p->succeeded_pair : p;
+        if (check->state == NICE_CHECK_SUCCEEDED &&
+            !check->use_candidate_on_next_check) {
+          check->use_candidate_on_next_check = TRUE;
+          priv_add_pair_to_triggered_check_queue (agent, check);
+          nominate_pending = TRUE;
+          nice_debug ("Agent %p : relay upgrade: nominate direct pair %p",
+              agent, p);
+        }
+      }
+      /* UDP sockets survive a timeout. Failed TCP checks can own a closed
+       * socket, so only keep their initial attempt, without reusing it. */
+      if (retry && p->state == NICE_CHECK_FAILED && !p->succeeded_pair &&
+          p->local->transport == NICE_CANDIDATE_TRANSPORT_UDP) {
+        p->valid = FALSE;
+        p->nominated = FALSE;
+        p->use_candidate_on_next_check = FALSE;
+        p->mark_nominated_on_response_arrival = FALSE;
+        if (p->discovered_pair) {
+          p->discovered_pair->valid = FALSE;
+          p->discovered_pair->nominated = FALSE;
+        }
+        SET_PAIR_STATE (agent, p, NICE_CHECK_WAITING);
+        nice_debug ("Agent %p : relay upgrade: retry direct pair %p", agent, p);
+      }
+    }
+  }
+  return keep_timer_going;
+}
 
