+
+/* Emit every successful Binding sample before candidate deduplication.
+ * Signals are queued so callbacks run outside the agent lock. */
+void agent_signal_stun_mapping (NiceAgent *agent, guint stream_id,
+    guint component_id, const NiceAddress *base, const NiceAddress *mapped,
+    const NiceAddress *server, guint sequence)
+{
+  gchar server_ip[NICE_ADDRESS_STRING_LEN];
+  NiceCandidate *sample = nice_candidate_new (NICE_CANDIDATE_TYPE_SERVER_REFLEXIVE);
+  sample->stream_id = stream_id;
+  sample->component_id = component_id;
+  sample->transport = NICE_CANDIDATE_TRANSPORT_UDP;
+  sample->base_addr = *base;
+  sample->addr = *mapped;
+  nice_address_to_string (server, server_ip);
+  agent_queue_signal (agent, signals[SIGNAL_STUN_MAPPING], sample, server_ip,
+      nice_address_get_port (server), sequence);
+  nice_candidate_free (sample);
 }
 
